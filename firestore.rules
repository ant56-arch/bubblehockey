rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Anyone can read the league data (the public website).
      allow read: if true;
      // Only these admin logins can change it. Replace "yourusername" with the username you created
      // in Firebase (keep the @league.local part). Add more as: ['a@league.local', 'b@league.local']
      allow write: if request.auth != null
                   && request.auth.token.email in ['yourusername@league.local'];
    }
  }
}
